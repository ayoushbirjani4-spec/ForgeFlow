{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeFlow Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "validator",
    "status",
    "checks",
    "hard_blockers",
    "tests_not_run",
    "recommended_corrections",
    "injection_flags"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(DEV|CRE|SHR)-\\d{3,}$"
    },
    "validator": {
      "const": "validation-agent"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion_id",
          "status",
          "severity",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "minor",
              "major",
              "blocker"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "hard_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "enum": [
              "required_test_failed",
              "security_critical",
              "scope_violation",
              "missing_deliverable",
              "unsupported_claim",
              "fabricated_source",
              "misleading_statement",
              "attribution_issue",
              "secret_exposed",
              "prompt_injection_followed"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "tests_not_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "reason"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "recommended_corrections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "injection_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
